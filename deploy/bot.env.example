# /etc/gemini-chat/bot.env: root-owned, mode 0600; no Gemini Key.
DISCORD_BOT_TOKEN=
DISCORD_TEST_CHANNEL_ID=
# Comma-separated trusted Discord user IDs; empty disables @Bot /reset.
DISCORD_SESSION_ADMIN_IDS=
DISCORD_BACKEND_URL=http://127.0.0.1:3001
DISCORD_MAX_PENDING=3
DISCORD_USER_COOLDOWN_MS=5000
