# /etc/gemini-chat/server.env: root-owned, mode 0600; no Discord Token.
HOST=127.0.0.1
PORT=3001
SESSION_DATA_DIR=/var/lib/gemini-chat
STATIC_DIRECTORY=/opt/gemini-chat/current/dist/web
ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
GEMINI_API_KEY=
GEMINI_REQUESTS_PER_MINUTE=10
# Web may use the full total; Discord shares total minus reserved (default 6).
# Positive integer, strictly below total; omitted reservation stays 4.
GEMINI_WEB_RESERVED_REQUESTS_PER_MINUTE=4
GEMINI_RATE_LIMIT_COOLDOWN_MS=60000

# P1-2: generation only; leaves headroom below the Bot's unchanged 120s deadline.
CHAT_GENERATION_FIRST_CHUNK_TIMEOUT_MS=60000
CHAT_GENERATION_TOTAL_TIMEOUT_MS=90000
# first <= total <= 110000; total + 2 * CHAT_COUNT_TIMEOUT_MS <= 115000.

# P0-1: bounded prompt window. Estimates are conservative, not exact token counts.
CHAT_CONTEXT_INPUT_TOKENS=8192
CHAT_CONTEXT_HISTORY_TURNS=20
# Includes thinking tokens; MAX_TOKENS replies carry a visible truncation notice.
CHAT_MAX_OUTPUT_TOKENS=8192
# Independent countTokens budget; max 2 counts per selection, 80% edge threshold.
CHAT_COUNT_TIMEOUT_MS=3000
CHAT_COUNTS_PER_MINUTE=20
# Web may use all counts; Discord shares total minus reserved (default 12).
# Positive integer, strictly below total; omitted reservation stays 8.
CHAT_WEB_RESERVED_COUNTS_PER_MINUTE=8
# Only trusted server configuration becomes a system instruction; history system is omitted.
GEMINI_SYSTEM_INSTRUCTION=
