[Unit]
Description=Task 18 read-only online validation sample
After=gemini-server.service gemini-bot.service

[Service]
Type=oneshot
ExecStart=/opt/gemini-validation/validate-online.sh --sample
TimeoutStartSec=30
User=root
UMask=0077
StateDirectory=gemini-validation
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gemini-validation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
