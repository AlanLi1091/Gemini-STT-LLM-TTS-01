# Gemini API key is loaded by the server only. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated, exact-match browser origins allowed to call the server.
ALLOWED_ORIGINS=http://localhost:3000,https://your-playground.example.com

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
