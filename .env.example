# Gemini API key is loaded by the server only. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated, exact-match browser origins allowed to call the server.
ALLOWED_ORIGINS=http://localhost:3000,https://your-playground.example.com

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Discord Demo / Bot: server-only; never use VITE_ variables for tokens.
DISCORD_BOT_TOKEN=
DISCORD_TEST_CHANNEL_ID=
# Comma-separated trusted Discord user IDs; empty disables @Bot /reset.
DISCORD_SESSION_ADMIN_IDS=
# Bot calls Express on the same machine; use the matching local server port.
DISCORD_BACKEND_URL=http://127.0.0.1:3001

# Local protection limits; these do not discover the provider account quota.
DISCORD_MAX_PENDING=3
DISCORD_USER_COOLDOWN_MS=5000
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_RATE_LIMIT_COOLDOWN_MS=60000

# P0-1: bounded prompt window. Estimates are conservative, not exact token counts.
CHAT_CONTEXT_INPUT_TOKENS=8192
CHAT_CONTEXT_HISTORY_TURNS=20
# Includes thinking tokens; MAX_TOKENS replies carry a visible truncation notice.
CHAT_MAX_OUTPUT_TOKENS=8192
# Independent countTokens budget; max 2 counts per selection, 80% edge threshold.
CHAT_COUNT_TIMEOUT_MS=3000
CHAT_COUNTS_PER_MINUTE=20
# Only trusted server configuration becomes a system instruction; history system is omitted.
GEMINI_SYSTEM_INSTRUCTION=
